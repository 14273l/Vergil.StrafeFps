local ChamsState = {
    Enabled       = false,
    TeamCheck     = true,
    IncludeNPCs   = true,
    VisibleColor  = { Color3.fromRGB(155, 155, 255), 0.0 },
    OccludedColor = { Color3.fromRGB(255, 255, 255), 0.8 },
}

local ChamsCache   = {}
local IgnoreNames  = { HumanoidRootPart = true }

local function createAdornment(part, isHead, vis)
    local adorn = Instance.new("BoxHandleAdornment")
    local offset_base      = (vis == 1) and -0.05 or 0.05
    local head_size_offset = (vis == 1) and -0.2  or 0.2
    if isHead then
        adorn.Size = Vector3.new(1,1,1) + Vector3.new(head_size_offset, head_size_offset, head_size_offset)
    else
        adorn.Size = part.Size + Vector3.new(offset_base, offset_base, offset_base)
    end
    adorn.Adornee     = part
    adorn.Parent      = part
    adorn.ZIndex      = (vis == 1) and 2 or 1
    adorn.AlwaysOnTop = (vis == 1)
    adorn.Visible     = false
    return adorn
end

local function isTeammateChar(char)
    local ok, res = pcall(function() return utility:isFriendlyCharacter(char) end)
    if ok then return res end
    return false
end

local function shouldChams(char)
    if not ChamsState.Enabled then return false end
    if char == LocalPlayer.Character then return false end
    if ChamsState.TeamCheck and isTeammateChar(char) then return false end
    return true
end

local function applyToChar(char, isTarget)
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") and not IgnoreNames[part.Name] then
            local ad = ChamsCache[part]
            if not ad then
                local isHead = (part.Name == "Head")
                ad = {
                    createAdornment(part, isHead, 1),
                    createAdornment(part, isHead, 2),
                }
                ChamsCache[part] = ad
            end
            ad[1].Visible      = isTarget
            ad[2].Visible      = isTarget
            if isTarget then
                ad[1].Color3        = ChamsState.OccludedColor[1]
                ad[1].Transparency  = ChamsState.OccludedColor[2]
                ad[2].Color3        = ChamsState.VisibleColor[1]
                ad[2].Transparency  = ChamsState.VisibleColor[2]
            end
        end
    end
end

local function collectTracked()
    local set = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then set[plr.Character] = true end
    end
    if ChamsState.IncludeNPCs then
        local ok, humans = pcall(function() return Workspace:QueryDescendants("Humanoid") end)
        if ok and humans then
            for _, h in ipairs(humans) do
                local char = h.Parent
                if char and not set[char] and char:FindFirstChild("Head")
                   and not Players:GetPlayerFromCharacter(char) then
                    set[char] = true
                end
            end
        else
            local function checkModel(m)
                if m:IsA("Model") and not set[m]
                   and m:FindFirstChildOfClass("Humanoid")
                   and m:FindFirstChild("Head")
                   and not Players:GetPlayerFromCharacter(m) then
                    set[m] = true
                end
            end
            for _, obj in ipairs(Workspace:GetChildren()) do
                checkModel(obj)
                if obj:IsA("Folder") then
                    for _, child in ipairs(obj:GetChildren()) do checkModel(child) end
                end
            end
        end
    end
    return set
end

local lastChamsScan = 0
local trackedChars  = {}

RunService.RenderStepped:Connect(function()
    local now = tick()
    if now - lastChamsScan > 0.5 then
        lastChamsScan = now
        trackedChars  = collectTracked()
    end

    for _, ad in pairs(ChamsCache) do
        ad[1].Visible = false
        ad[2].Visible = false
    end

    if ChamsState.Enabled then
        for char in pairs(trackedChars) do
            if char.Parent then
                applyToChar(char, shouldChams(char))
            end
        end
    end

    for part, ad in pairs(ChamsCache) do
        if not part.Parent then
            ad[1]:Destroy()
            ad[2]:Destroy()
            ChamsCache[part] = nil
        end
    end
end)

