local FOVState = {
    Enabled  = false,
    Value    = 120,
    Original = camera.FieldOfView,
}

local function enforceFOV()
    if not FOVState.Enabled then return end
    local cam = workspace.CurrentCamera
    if cam and cam.FieldOfView ~= FOVState.Value then
        cam.FieldOfView = FOVState.Value
    end
end

RunService.RenderStepped:Connect(enforceFOV)

camera:GetPropertyChangedSignal("FieldOfView"):Connect(function()
    if FOVState.Enabled and camera.FieldOfView ~= FOVState.Value then
        camera.FieldOfView = FOVState.Value
    end
end)

