local ArmsState = { Enabled = true, Hide = false, Material = Enum.Material.Neon, Color = Color3.fromRGB(255,255,255) }

local camera = workspace.CurrentCamera

local function getGroup(part, root)
    local p = part
    while p and p ~= root do
        if p.Name == "Parts" then return "parts" end
        if p.Name == "Arms"  then return "arms"  end
        p = p.Parent
    end
    return nil
end

local Backups = {}

local function backup(part)
    local bk = Backups[part]
    if bk then return bk end
    bk = { Material = part.Material, Color = part.Color, TextureID = nil, SAs = {} }
    Backups[part] = bk
    if part:IsA("MeshPart") and part.TextureID ~= "" then bk.TextureID = part.TextureID end
    for _, ch in ipairs(part:GetChildren()) do
        if ch:IsA("SurfaceAppearance") then table.insert(bk.SAs, ch) end
    end
    return bk
end

local function applyStyle(part, material, color)
    backup(part)
    if part:IsA("MeshPart") and part.TextureID ~= "" then part.TextureID = "" end
    for _, ch in ipairs(part:GetChildren()) do
        if ch:IsA("SurfaceAppearance") then ch.Parent = nil end
    end
    for _, ch in ipairs(part:GetChildren()) do
        if ch:IsA("Decal") or ch:IsA("Texture") then
            if ch.Transparency < 1 then ch.Transparency = 1 end
        end
    end
    if part.Material ~= material then part.Material = material end
    if part.Color    ~= color    then part.Color    = color    end
    if part.CanCollide then part.CanCollide = false end
    if not part.Massless then part.Massless = true end
    if part.CanQuery    then part.CanQuery = false end
    if part.CastShadow  then part.CastShadow = false end
end

local function restorePart(part)
    local bk = Backups[part]
    if not bk then return end
    if bk.TextureID and part:IsA("MeshPart") then part.TextureID = bk.TextureID end
    for _, sa in ipairs(bk.SAs) do
        if sa and not sa.Parent and part.Parent then sa.Parent = part end
    end
    if part.Material ~= bk.Material then part.Material = bk.Material end
    if part.Color    ~= bk.Color    then part.Color    = bk.Color    end
    Backups[part] = nil
end

local function restoreGroup(group)
    local vm = camera:FindFirstChild("Viewmodel")
    if not vm then return end
    for _, obj in ipairs(vm:GetDescendants()) do
        if obj:IsA("BasePart") and getGroup(obj, vm) == group then restorePart(obj) end
    end
end

